{
  "dashboard": {
    "title": "AulaIA - Overview",
    "uid": "aulaia-overview",
    "tags": ["aulaia", "overview", "production"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Backend - Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count[5m])",
            "legendFormat": "{{method}} {{uri}} {{status}}",
            "refId": "A"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [{"format": "reqps"}, {"format": "short"}]
      },
      {
        "title": "Backend - Response Time (p95)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [{"format": "s"}, {"format": "short"}]
      },
      {
        "title": "JVM Memory Usage",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"}",
            "legendFormat": "Heap Used",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_max_bytes{area=\"heap\"}",
            "legendFormat": "Heap Max",
            "refId": "B"
          },
          {
            "expr": "jvm_memory_used_bytes{area=\"nonheap\"}",
            "legendFormat": "Non-Heap Used",
            "refId": "C"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [{"format": "bytes"}, {"format": "short"}]
      },
      {
        "title": "JVM Threads",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "jvm_threads_live",
            "legendFormat": "Live Threads",
            "refId": "A"
          },
          {
            "expr": "jvm_threads_daemon",
            "legendFormat": "Daemon Threads",
            "refId": "B"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [{"format": "short"}, {"format": "short"}]
      },
      {
        "title": "Asistencia Registrada (últimas 24h)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "increase(aulaia_asistencia_total[24h])",
            "legendFormat": "Total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        }
      },
      {
        "title": "FastAPI - Health",
        "type": "stat",
        "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "up{job=\"fastapi\"}",
            "legendFormat": "Status",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
            ]
          }
        }
      },
      {
        "title": "PostgreSQL - Conexiones",
        "type": "stat",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"aulaia_db\"}",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Traefik - Requests/sec",
        "type": "graph",
        "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "rate(traefik_entrypoint_requests_total[5m])",
            "legendFormat": "{{entrypoint}}",
            "refId": "A"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [{"format": "reqps"}, {"format": "short"}]
      }
    ]
  },
  "overwrite": true
}