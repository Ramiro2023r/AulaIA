# ============================================
# AulaIA — .env.example (Variables de entorno)
# Copia a .env y reemplaza CHANGE_ME con valores reales
# ============================================

# --- PostgreSQL (reemplaza CHANGE_ME antes de iniciar) ---
POSTGRES_DB=aulaia_db
POSTGRES_USER=aulaia_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Spring Boot Backend ---
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRATION=3600000
APP_DEMO_USERS_ENABLED=true

# --- FastAPI ---
DATA_SCIENCE_PORT=8000
# Opcional. Se reserva para futuras integraciones sin exponerla en Git.
GROQ_API_KEY=

# --- Frontend ---
FRONTEND_PORT=4200

BACKEND_PORT=8080

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ENABLED=false
TELEGRAM_POLLING_INTERVAL_MS=3000
