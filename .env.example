# ============================================
# AulaIA — Variables de entorno de ejemplo
# Copia este archivo a .env y reemplaza los valores.
# NUNCA subas .env al repositorio.
# ============================================

# --- PostgreSQL (contenedor Docker) ---
POSTGRES_DB=aulaia_db
POSTGRES_USER=aulaia_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend Spring Boot ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
# Puerto de ejemplo del entorno local (puede variar según la
# instalación de PostgreSQL del desarrollador: 5432, 5433, ...).
DB_PORT=5433
DB_NAME=aulaia_db
DB_USERNAME=aulaia_user
DB_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME
# Expiración del token JWT en milisegundos (3600000 = 1 hora).
JWT_EXPIRATION=3600000

# --- Bootstrap del administrador inicial (Sprint 2) ---
# Deshabilitado por defecto. Activar solo en instalaciones SIN administrador
# (local, Docker, demo, primer despliegue). Tras crear el primer ADMIN se
# recomienda volver a AULAIA_BOOTSTRAP_ADMIN_ENABLED=false.
# AULAIA_BOOTSTRAP_ADMIN_PASSWORD es SOLO un placeholder: usa una contraseña
# fuerte real (mínimo 12 caracteres) en tu entorno, nunca la dejes en el repo.
AULAIA_BOOTSTRAP_ADMIN_ENABLED=false
AULAIA_BOOTSTRAP_ADMIN_USERNAME=admin
AULAIA_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- Servicio de IA (FastAPI) ---
IA_SERVICE_URL=http://localhost:8000