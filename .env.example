# ============================================
# AulaIA — .env.example (Variables de entorno)
# Copia a .env y reemplaza CHANGE_ME con valores reales
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=aulaia_db
POSTGRES_USER=aulaia_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Spring Boot Backend ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_HOST=postgres
DB_PORT=5432
DB_NAME=aulaia_db
DB_USERNAME=aulaia_user
DB_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRATION=3600000

# Bootstrap admin (solo primera instalación)
AULAIA_BOOTSTRAP_ADMIN_ENABLED=false
AULAIA_BOOTSTRAP_ADMIN_USERNAME=admin
AULAIA_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- FastAPI ---
IA_SERVICE_URL=http://fastapi:8000
FASTAPI_PORT=8000

# --- Frontend ---
FRONTEND_PORT=4200

# --- Backend port (para docker compose) ---
BACKEND_PORT=8080